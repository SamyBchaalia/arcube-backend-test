PORT=4000
APP_URL=http://localhost:4000
ANTHROPIC_API_KEY=your-anthropic-api-key

# NBV chatbot lead capture (Lou call-back requests)
# Off by default so the new behaviour can be reviewed on staging first.
NBV_LEAD_CAPTURE_ENABLED=false
# Model used by POST /shorten/nbv
NBV_CHAT_MODEL=claude-sonnet-4-6
# Who receives "Website lead" emails (defaults: Lou, copy to CONTACT_RECIPIENT)
LEAD_NOTIFY_TO=lounatale@nbvgroup.ca
LEAD_NOTIFY_CC=
# Base URL of the admin chat-history page; the session id is appended
ADMIN_DASHBOARD_URL=https://nbvgroup.ca/admin/chat-history
